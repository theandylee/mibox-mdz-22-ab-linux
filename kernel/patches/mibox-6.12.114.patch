+// SPDX-License-Identifier: GPL-2.0
+/* Xiaomi Mi Box S (MDZ-22-AB), minimal bring-up: p212 base + facts learned from the stock recovery kernel. */
+#include "meson-gxl-s905x-p212.dts"
+
+/ {
+	model = "Xiaomi Mi Box S";
+	amlogic-dt-id = "gxl_oneday_pmic";
+	compatible = "xiaomi,mdz-22-ab", "amlogic,s905x", "amlogic,meson-gxl";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		ramoops@7400000 {
+			compatible = "ramoops";
+			reg = <0x0 0x7400000 0x0 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x80000>;
+			pmsg-size = <0x20000>;
+			max-reason = <4>;
+		};
+
+		fb_logo: framebuffer@3d800000 {
+			reg = <0x0 0x3d800000 0x0 0x1000000>;
+			no-map;
+		};
+	};
+};
+
+/* display: let meson-drm (HDMI, from p212 base) take over */
+
+/*
+ * single USB port: OTG glue (id pin = device by default); /init switches it to host through
+ * /sys/class/usb_role at boot to look for a USB root, and back to device (gadget serial) if none is found.
+ * VBUS = GPIOAO_3 (vendor DT `gpio-vbus-power`), switched by the glue only in host mode.
+ */
+/ {
+	usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "USB_VBUS";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&usb {
+	dr_mode = "otg";
+	vbus-supply = <&usb_vbus>;
+};
+&dwc2 { dr_mode = "peripheral"; };
+
+/*
+ * Real per-box MAC addresses. The values below are PLACEHOLDERS: kernel/build.sh patches the compiled DTB
+ * with WIFI_MAC / BT_MAC (env or kernel/macs.env); all-zero = "not set" (driver falls back to random / invalid).
+ * Stock Android shows them: adb shell getprop ro.boot.wifimac / ro.boot.btmacaddr
+ */
+&sd_emmc_a {
+	brcmf: wifi@1 {
+		reg = <1>;
+		compatible = "brcm,bcm4329-fmac";
+		local-mac-address = [de ad be ef 00 01];
+	};
+};
+
+&uart_A {
+	bluetooth {
+		local-bd-address = [de ad be ef 00 02];	/* LSB first */
+	};
+};
